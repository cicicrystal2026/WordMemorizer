page {
  min-height: 100%;
  background: #f6f2ff;
  color: #241b38;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page {
  padding: 28rpx 28rpx 60rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  background: #fff;
  border: 1rpx solid #eee8fb;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 36rpx rgba(75, 48, 145, 0.08);
}

.primary,
.secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.primary {
  color: #fff;
  background: linear-gradient(135deg, #7c55e8, #5736bf);
}

.secondary {
  color: #5f40c2;
  background: #eee8ff;
}

.muted {
  color: #81788f;
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 34rpx;
  font-weight: 800;
}

button::after {
  border: 0;
}
