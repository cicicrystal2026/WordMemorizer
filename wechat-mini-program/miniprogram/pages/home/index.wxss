.hero,
.mission-head,
.stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero {
  padding: 20rpx 8rpx 28rpx;
}

.eyebrow {
  color: #765ac7;
  font-size: 24rpx;
}

.title {
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 900;
}

.streak {
  padding: 14rpx 20rpx;
  background: #fff3dd;
  border-radius: 28rpx;
  color: #a76012;
  font-weight: 700;
}

.number {
  margin-top: 6rpx;
  font-size: 64rpx;
  font-weight: 900;
}

.number text {
  color: #8c8499;
  font-size: 28rpx;
}

.percent {
  color: #6543ca;
  font-size: 36rpx;
  font-weight: 800;
}

.stats {
  margin: 26rpx 0;
}

.stats view {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 800;
}

.stats .muted {
  font-size: 22rpx;
  font-weight: 400;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.quick-grid button {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 22rpx 8rpx;
  background: #f7f3ff;
  border-radius: 20rpx;
  color: #3d3154;
  font-size: 24rpx;
}

.quick-grid button text:first-child {
  font-size: 42rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 30rpx 0;
  text-align: center;
}

.word-preview view {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0ecf6;
}
