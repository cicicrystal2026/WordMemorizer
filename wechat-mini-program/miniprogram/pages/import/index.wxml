<view class="page">
  <view class="card">
    <view class="section-title">拍照导入老师的单词表</view>
    <view class="muted help">支持印刷体、表格截图和较清晰的手写英文。识别后会由 AI 补充词性、音标、释义、搭配和例句。</view>
    <button class="photo" bindtap="chooseImage" disabled="{{processing}}">
      <text>📷</text>
      <text>{{processing ? "正在识别并整理…" : "拍照或从相册选择"}}</text>
    </button>
  </view>

  <view wx:if="{{step === 'review'}}" class="card">
    <view class="review-head">
      <view class="section-title">确认识别结果</view>
      <text class="muted">{{words.length}} 个词</text>
    </view>
    <view class="word-row" wx:for="{{words}}" wx:key="word">
      <view>
        <input value="{{item.word}}" data-index="{{index}}" data-field="word" bindinput="editWord" />
        <input class="meaning" value="{{item.meaning}}" data-index="{{index}}" data-field="meaning" bindinput="editWord" />
      </view>
      <button data-index="{{index}}" bindtap="removeWord">删除</button>
    </view>
    <view class="target-row">
      <text>每天背多少个</text>
      <input type="number" value="{{dailyTarget}}" bindinput="setTarget" />
    </view>
    <button class="primary" bindtap="confirm">确认导入并生成计划</button>
  </view>
</view>
