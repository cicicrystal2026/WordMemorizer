.help {
  line-height: 1.7;
}

.photo {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 28rpx;
  padding: 48rpx;
  border: 2rpx dashed #bba9eb;
  border-radius: 24rpx;
  color: #6544ca;
  background: #f9f7ff;
}

.photo text:first-child {
  font-size: 62rpx;
}

.review-head,
.target-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.word-row {
  display: grid;
  grid-template-columns: 1fr 100rpx;
  gap: 12rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eee9f5;
}

.word-row input {
  padding: 8rpx 0;
  font-size: 30rpx;
  font-weight: 700;
}

.word-row .meaning {
  color: #776d82;
  font-size: 24rpx;
  font-weight: 400;
}

.word-row button {
  align-self: center;
  color: #ba3046;
  background: transparent;
  font-size: 24rpx;
}

.target-row {
  margin: 30rpx 0;
}

.target-row input {
  width: 140rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  text-align: center;
  background: #f3effb;
}
