.parent-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 8rpx 30rpx;
}

.eyebrow {
  color: #765ac7;
  font-size: 24rpx;
}

.title {
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 900;
}

.bind {
  margin: 0;
  padding: 12rpx 20rpx;
  border-radius: 24rpx;
  color: #5c3ebc;
  background: #eee8ff;
  font-size: 24rpx;
  line-height: 1.4;
}

.child-picker {
  font-size: 32rpx;
  font-weight: 800;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.summary-grid view {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #f8f5ff;
}

.summary-grid text:first-child {
  color: #5d3fc0;
  font-size: 46rpx;
  font-weight: 900;
}

.summary-grid text:last-child {
  color: #81788f;
  font-size: 24rpx;
}

.chart {
  display: flex;
  align-items: end;
  justify-content: space-between;
  height: 300rpx;
}

.chart > view {
  display: flex;
  flex: 1;
  align-items: center;
  flex-direction: column;
  gap: 8rpx;
  font-size: 20rpx;
}

.bar-wrap {
  display: flex;
  align-items: end;
  width: 34rpx;
  height: 190rpx;
  border-radius: 18rpx;
  background: #eee8f9;
  overflow: hidden;
}

.bar {
  width: 100%;
  min-height: 8rpx;
  border-radius: 18rpx;
  background: linear-gradient(#8f6cef, #5c3fc0);
}

.count {
  color: #5d3fc0;
  font-weight: 700;
}

.attention view {
  display: flex;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eee9f5;
}

.attention text:last-child {
  font-weight: 800;
}

.empty {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  text-align: center;
}
